# ============================================================
# metanoia-hub — Variáveis de PRODUÇÃO (template)
# ============================================================
# Copie para .env.production e preencha com segredos REAIS:
#   cp .env.production.example .env.production
# NUNCA commitar .env.production (já coberto por .gitignore via .env*).
#
# Gerar segredos fortes:  openssl rand -base64 32
# ============================================================

# --- Portas expostas no host (faixa dedicada — não conflita com o Swarm) ---
WEB_HOST_PORT=8090
API_HOST_PORT=8091
KEYCLOAK_HOST_PORT=8092
MINIO_CONSOLE_HOST_PORT=8093
MINIO_API_HOST_PORT=8094
LIVEKIT_HOST_PORT=7880
# Portas RTC do LiveKit (mídia WebRTC) — abrir no firewall/cloud.
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882

# --- PostgreSQL (interno; sem porta no host) ---
POSTGRES_USER=metanoia
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=metanoia_prod

# Conexão admin (superuser — migrations). Host = nome do serviço na rede interna.
DATABASE_URL=postgresql://metanoia:CHANGE_ME_strong_db_password@postgres:5432/metanoia_prod
# Conexão da aplicação (role non-superuser — RLS). O role metanoia_app e sua
# senha são criados por docker/postgres/init-app-role.sql, que hoje FIXA a senha
# 'metanoia_app_pass'. Use o MESMO valor aqui — ou edite o SQL para trocar.
DATABASE_APP_URL=postgresql://metanoia_app:metanoia_app_pass@postgres:5432/metanoia_prod

# --- Redis (interno) ---
# REDIS_PASSWORD=CHANGE_ME_redis_password   # se habilitar requirepass no compose

# --- Keycloak ---
# URL pública (domínio HTTPS) — usada como issuer/hostname. DEVE ser acessível
# pelos navegadores dos usuários e bater com o issuer dos tokens.
KEYCLOAK_PUBLIC_URL=https://auth.metanoia-hub.todo-tips.com
KEYCLOAK_REALM=metanoia
KEYCLOAK_CLIENT_ID=metanoia-web
KEYCLOAK_API_CLIENT_ID=metanoia-api
KEYCLOAK_API_CLIENT_SECRET=CHANGE_ME_keycloak_api_client_secret
KEYCLOAK_EXPECTED_AUDIENCE=metanoia-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password

# --- MinIO ---
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET=metanoia-storage

# --- LiveKit ---
LIVEKIT_API_KEY=CHANGE_ME_livekit_key
LIVEKIT_API_SECRET=CHANGE_ME_livekit_secret
# URL pública de sinalização (wss) entregue ao browser pela API.
LIVEKIT_PUBLIC_URL=wss://video.metanoia-hub.todo-tips.com

# --- Web (Next) ---
# Build-time: URL pública da API que o cliente vai chamar.
NEXT_PUBLIC_API_URL=https://api.metanoia-hub.todo-tips.com/api/v1
# URL pública do frontend (CORS na API + links em e-mails).
FRONTEND_URL=https://app.metanoia-hub.todo-tips.com

# --- Sentry (opcional) ---
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Email / Resend (Story 14-3) ---
# OBRIGATÓRIO: a API não inicia sem RESEND_API_KEY (env.validation, sem default).
# Use uma chave real (re_...) para habilitar o envio de e-mail. Sem chave válida,
# as notificações in-app/SSE continuam funcionando, mas o e-mail fica inativo.
RESEND_API_KEY=re_your_real_key_here
# Opcional (tem default no schema): remetente padrão dos e-mails.
# EMAIL_DEFAULT_FROM=Metanoia <notifications@metanoia.app>
