// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`OnboardingProgressSchema > accepts valid progress (completed) 1`] = `
{
  "data": {
    "completed": true,
    "completedAt": "2026-06-13T12:00:00.000Z",
    "completedSteps": [
      1,
      2,
      3,
      4,
      5,
    ],
    "currentStep": 5,
    "skippedAt": null,
    "stepData": {},
  },
  "success": true,
}
`;

exports[`OnboardingProgressSchema > accepts valid progress (in-progress) 1`] = `
{
  "data": {
    "completed": false,
    "completedAt": null,
    "completedSteps": [
      1,
      2,
    ],
    "currentStep": 3,
    "skippedAt": null,
    "stepData": {
      "mode": "real-group",
    },
  },
  "success": true,
}
`;

