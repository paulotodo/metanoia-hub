# ============================================
# metanoia-hub — Environment Variables
# ============================================
# Copy to .env and fill in values:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=metanoia
POSTGRES_PASSWORD=metanoia_dev_pass
POSTGRES_DB=metanoia_dev

# Admin connection (superuser — used for migrations)
DATABASE_URL=postgresql://metanoia:metanoia_dev_pass@localhost:5432/metanoia_dev

# Application connection (non-superuser — RLS enforced)
DATABASE_APP_URL=postgresql://metanoia_app:metanoia_app_pass@localhost:5432/metanoia_dev

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=metanoia
KEYCLOAK_CLIENT_ID=metanoia-app
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=metanoia-storage

# --- LiveKit (video/audio) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_dev_only_not_for_production

# --- API ---
API_PORT=3001
NODE_ENV=development

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
