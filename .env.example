# ============================================
# metanoia-hub — Environment Variables
# ============================================
# Copy to .env and fill in values:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=metanoia
POSTGRES_PASSWORD=metanoia_dev_pass
POSTGRES_DB=metanoia_dev

# Admin connection (superuser — used for migrations)
DATABASE_URL=postgresql://metanoia:metanoia_dev_pass@localhost:5432/metanoia_dev

# Application connection (non-superuser — RLS enforced)
DATABASE_APP_URL=postgresql://metanoia_app:metanoia_app_pass@localhost:5432/metanoia_dev

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=metanoia
KEYCLOAK_CLIENT_ID=metanoia-web
KEYCLOAK_API_CLIENT_ID=metanoia-api
KEYCLOAK_API_CLIENT_SECRET=dev-secret-only-not-for-production
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Google OAuth (for Keycloak Identity Provider) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=metanoia-storage

# --- LiveKit (video/audio) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_dev_only_not_for_production

# --- Sentry (error tracking) ---
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
# Traces sampling rate in [0.0, 1.0]. Defaults: 0.2 in production, 1.0 otherwise.
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- API ---
API_PORT=3001
NODE_ENV=development

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Destino do rewrite Next → NestJS em dev (server-side only)
API_REWRITE_TARGET=http://localhost:3001
# MSW (Mock Service Worker) — `enabled` apenas em test env ou dev offline
# controlado. Qualquer outro valor (ou ausência) deixa o app falar com a API
# real definida em NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MOCKING=disabled
