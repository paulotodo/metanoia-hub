{
  "extends": "@metanoia/config/tsconfig/next",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@mocks/*": ["./__mocks__/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "vitest.setup.ts", "**/*.spec.ts", "**/*.spec.tsx"]
}
