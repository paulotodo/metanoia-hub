{
  "name": "@metanoia/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:rls": "bash scripts/apply-rls.sh",
    "db:setup": "pnpm db:migrate && pnpm db:rls",
    "db:setup:ci": "pnpm db:migrate:deploy && pnpm db:rls",
    "db:seed": "prisma db seed",
    "db:seed:radar": "tsx prisma/seed-radar.ts",
    "db:seed:invites": "tsx prisma/seed-invites.ts",
    "db:seed:scenario-03": "tsx prisma/seed-scenario-03.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-express": "^11.1.18",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@sentry/nestjs": "^10.47.0",
    "@sentry/node": "^10.47.0",
    "bullmq": "^5.73.3",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "livekit-server-sdk": "^2.15.1",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@metanoia/config": "workspace:*",
    "eslint": "^9.39.4",
    "@metanoia/types": "workspace:*",
    "@nestjs/cli": "^11.0.18",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.18",
    "@types/express": "^5.0.6",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.7.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
