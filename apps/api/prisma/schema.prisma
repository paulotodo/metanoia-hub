generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Health check table — validates DB connectivity and migration status
model Health {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  status    String   @default("ok")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("_health")
}

/// Meeting event — stores real-time pipeline events for audit and replay
model MeetingEvent {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  meetingId String    @map("meeting_id") @db.Uuid
  eventType String    @map("event_type")
  userId    String?   @map("user_id") @db.Uuid
  payload   Json      @default("{}")
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, meetingId])
  @@map("meeting_events")
}

/// Meeting — a scheduled gathering for a discipleship group; lifecycle scheduled → live → ended → cancelled
model Meeting {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  groupId         String    @map("group_id") @db.Uuid
  title           String?   @db.VarChar(200)
  scheduledFor    DateTime  @map("scheduled_for") @db.Timestamptz
  durationMinutes Int?      @map("duration_minutes")
  status          String    @default("scheduled") @db.VarChar(16)
  topic           String?   @db.VarChar(500)
  livekitRoomId   String?   @map("livekit_room_id") @db.VarChar(200)
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  isDemoData      Boolean   @default(false) @map("is_demo_data")

  participants MeetingParticipantRecord[]
  reflections  Reflection[]

  @@index([tenantId, groupId, scheduledFor])
  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, isDemoData])
  @@map("meetings")
}

/// MeetingParticipantRecord — per-meeting confirmation + presence (joinedAt/leftAt auto-filled by LiveKit webhooks)
model MeetingParticipantRecord {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  meetingId     String    @map("meeting_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  name          String    @db.VarChar(200)
  response      String    @default("pending") @db.VarChar(8)
  joinedAt      DateTime? @map("joined_at") @db.Timestamptz
  leftAt        DateTime? @map("left_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, participantId])
  @@index([tenantId, meetingId])
  @@map("meeting_participants")
}

/// MeetingAttendance — final aggregated presence record after meeting end (Story 5.3)
model MeetingAttendance {
  id                   String    @id @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  meetingId            String    @map("meeting_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  joinTime             DateTime  @map("join_time") @db.Timestamptz
  leaveTime            DateTime  @map("leave_time") @db.Timestamptz
  totalDurationSeconds Int       @map("total_duration_seconds")
  presenceType         String    @map("presence_type") @db.VarChar(16)
  reconnections        Int       @default(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz
  isDemoData           Boolean   @default(false) @map("is_demo_data")

  @@unique([meetingId, userId])
  @@index([tenantId, meetingId])
  @@index([tenantId, userId])
  @@index([tenantId, isDemoData])
  @@map("meeting_attendance")
}

/// MeetingTelemetry — per-user engagement signals captured during a meeting (Story 5.4)
model MeetingTelemetry {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  meetingId           String    @map("meeting_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  cameraOnSeconds     Int       @default(0) @map("camera_on_seconds")
  roomDurationSeconds Int       @default(0) @map("room_duration_seconds")
  focusScore          Decimal?  @map("focus_score") @db.Decimal(3, 2)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  isDemoData          Boolean   @default(false) @map("is_demo_data")

  @@unique([meetingId, userId])
  @@index([tenantId, meetingId])
  @@index([tenantId, isDemoData])
  @@map("meeting_telemetry")
}

/// MeetingReport — post-meeting aggregated report (attendees + metrics) (Story 5.6)
model MeetingReport {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  meetingId   String   @map("meeting_id") @db.Uuid
  summary     Json     @default("{}")
  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz

  @@unique([meetingId])
  @@index([tenantId, meetingId])
  @@map("meeting_reports")
}

/// MeetingSnapshot — periodic state checkpoint for crash recovery (Story 5.3)
model MeetingSnapshot {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  meetingId    String   @map("meeting_id") @db.Uuid
  snapshotData Json     @default("{}") @map("snapshot_data")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, meetingId, createdAt])
  @@map("meeting_snapshots")
}

/// Reflection — post-meeting narrative capture by the leader (1–280 chars, Zod enforced)
model Reflection {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  meetingId  String    @map("meeting_id") @db.Uuid
  leaderId   String    @map("leader_id") @db.Uuid
  text       String    @db.VarChar(280)
  recordedAt DateTime  @default(now()) @map("recorded_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([tenantId, meetingId])
  @@map("reflections")
}

/// Platform user — created at registration, tenant assigned later
model User {
  id                    String    @id @db.Uuid
  email                 String    @unique
  name                  String
  status                String    @default("pending_verification")
  tenantId              String?   @map("tenant_id") @db.Uuid
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  profilePhotoUrl       String?   @map("profile_photo_url")
  roleTitle             String?   @map("role_title")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  isDemoData            Boolean   @default(false) @map("is_demo_data")
  lastSeenAt            DateTime? @map("last_seen_at") @db.Timestamptz

  userTenants        UserTenant[]
  consents           Consent[]
  consentRecords     ConsentRecord[]
  groupMemberships   GroupMember[]
  pastoralAlerts     PastoralAlert[]             @relation("alerts")
  pastoralActions    PastoralAction[]            @relation("actions")
  pastoralNotes      PastoralNote[]              @relation("notes")
  radarStatuses      ParticipantRadarStatus[]    @relation("radarStatuses")
  statusImprovements ParticipantStatusImproved[] @relation("statusImprovements")

  @@index([tenantId])
  @@index([tenantId, isDemoData])
  @@map("users")
}

/// Join table — associates users with tenants and their role within each
model UserTenant {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  role      String    @default("participante")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

/// Consent record — tracks user acceptance of legal documents (LGPD)
model Consent {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  documentType String   @map("document_type")
  version      String
  ipAddress    String   @map("ip_address")
  userAgent    String   @map("user_agent")
  acceptedAt   DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("consents")
}

/// DataProcessingRegistry — global catalogue of data processing operations (LGPD Art. 9º).
/// No tenant_id; no RLS. Public endpoint: GET /api/v1/privacy/data-processing.
/// Seeded by migration 20260618000000_9-4-base-legal-consentimento.
model DataProcessingRegistry {
  id                String   @id @db.Uuid
  operationName     String   @map("operation_name")
  legalBasis        String   @map("legal_basis")
  purpose           String
  dataCategories    String[] @map("data_categories")
  retentionPeriod   String   @map("retention_period")
  thirdPartySharing String?  @map("third_party_sharing")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("data_processing_registry")
}

/// ConsentRecord — append-only log of consent withdrawals (LGPD Art. 8º §5).
/// Tenant-scoped (RLS NULLIF — same pattern as audit_events).
/// No UPDATE or DELETE policies: history is immutable.
model ConsentRecord {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  consentType String   @map("consent_type")
  action      String   @default("withdrawn")
  timestamp   DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, consentType], name: "consent_records_user_consent_idx")
  @@index([tenantId], name: "consent_records_tenant_idx")
  @@map("consent_records")
}

/// Tenant — materializes the implicit tenant, self-referencing tenant_id for universal RLS
model Tenant {
  id                    String   @id @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  name                  String
  slug                  String?  @unique @db.VarChar(60)
  plan                  String   @default("free") @db.VarChar(20)
  status                String   @default("active") @db.VarChar(32)
  adminEmail            String?  @map("admin_email") @db.VarChar(320)
  provisioningState     Json?    @map("provisioning_state")
  isDemo                Boolean  @default(false) @map("is_demo")
  focusIndicatorEnabled Boolean  @default(false) @map("focus_indicator_enabled")
  metadata              Json     @default("{}") @map("metadata") @db.JsonB
  onboardingProgress    Json?    @map("onboarding_progress") @db.JsonB
  planLimitsOverride    Json?    @map("plan_limits_override") @db.JsonB
  logoUrl               String?  @map("logo_url")
  brandPrimaryColor     String?  @map("brand_primary_color") @db.VarChar(9)
  brandSecondaryColor   String?  @map("brand_secondary_color") @db.VarChar(9)
  displayName           String?  @map("display_name") @db.VarChar(100)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  groups             Group[]
  invites            Invite[]
  radarStatuses      ParticipantRadarStatus[]
  statusImprovements ParticipantStatusImproved[]
  auditEvents        AuditEvent[]
  policies           TenantPolicies?

  @@index([tenantId])
  @@index([status])
  @@index([plan])
  @@map("tenants")
}

/// TenantPolicies — 1:0..1 with Tenant; stores 4 JSONB toggles + policy version.
/// focusMonitoring is NOT stored here — it maps tenant.focusIndicatorEnabled (Story 5).
/// RLS: tenant-scoped via tenant_id.
model TenantPolicies {
  id            String   @id @db.Uuid
  tenantId      String   @unique @map("tenant_id") @db.Uuid
  policies      Json     @default("{}") @map("policies")
  policyVersion Int      @default(1) @map("policy_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("tenant_policies")
}

/// Invite — pre-tenant onboarding token for admin/leader signup (5-leg flow)
model Invite {
  id              String    @id @db.Uuid
  token           String    @unique @db.Text
  tenantId        String?   @map("tenant_id") @db.Uuid
  leaderName      String    @map("leader_name") @db.VarChar(200)
  leaderEmail     String    @map("leader_email") @db.VarChar(320)
  churchName      String?   @map("church_name") @db.VarChar(200)
  kind            String    @default("pre_tenant_signup") @db.VarChar(32)
  inviteeRole     String?   @map("invitee_role") @db.VarChar(32)
  groupId         String?   @map("group_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([kind])
  @@map("invites")
}

/// Group — a discipleship small group within a tenant
model Group {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  dayOfWeek  String   @map("day_of_week") @db.VarChar(8)
  time       String   @db.VarChar(5)
  recurrence String   @default("weekly") @db.VarChar(16)
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  isDemoData Boolean  @default(false) @map("is_demo_data")
  /// Story 13.3: group operational status (active | on_break)
  status     String    @default("active") @db.VarChar(16)
  breakUntil DateTime? @map("break_until") @db.Timestamptz

  tenant             Tenant                      @relation(fields: [tenantId], references: [id])
  members            GroupMember[]
  alerts             PastoralAlert[]
  actions            PastoralAction[]
  radarStatuses      ParticipantRadarStatus[]
  statusImprovements ParticipantStatusImproved[]
  groupTrails        GroupTrail[]

  @@index([tenantId])
  @@index([tenantId, isDemoData])
  @@map("groups")
}

/// GroupMember — join table associating users with groups and their role within
model GroupMember {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  groupId    String    @map("group_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       String    @default("membro")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  isDemoData Boolean   @default(false) @map("is_demo_data")

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([tenantId])
  @@index([tenantId, isDemoData])
  @@map("group_members")
}

/// PastoralAlert — materialized signal per participant, written by signal engine, read by radar
model PastoralAlert {
  id               String       @id @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  participantId    String       @map("participant_id") @db.Uuid
  groupId          String       @map("group_id") @db.Uuid
  signalType       String       @map("signal_type")
  signalVariant    String?      @map("signal_variant")
  contextPhrase    String?      @map("context_phrase")
  observedFact     String?      @map("observed_fact")
  systemLimitation String?      @map("system_limitation")
  presenceDots     Json         @default("[]") @map("presence_dots")
  active           Boolean      @default(true)
  /// Story 6-3: status transition fields (additive)
  previousStatus   RadarStatus? @map("previous_status")
  newStatus        RadarStatus? @map("new_status")
  trend            RadarTrend?  @map("trend")
  readAt           DateTime?    @map("read_at")
  dismissedAt      DateTime?    @map("dismissed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz

  participant User  @relation("alerts", fields: [participantId], references: [id])
  group       Group @relation(fields: [groupId], references: [id])

  @@index([tenantId, active])
  @@index([participantId])
  @@index([tenantId, groupId, dismissedAt])
  @@map("pastoral_alerts")
}

/// PastoralAction — care action recorded by the leader
model PastoralAction {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  groupId       String    @map("group_id") @db.Uuid
  performedBy   String    @map("performed_by") @db.Uuid
  actionType    String    @map("action_type")
  signalType    String    @map("signal_type")
  note          String?
  recordedAt    DateTime  @default(now()) @map("recorded_at")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  isDemoData    Boolean   @default(false) @map("is_demo_data")

  participant User  @relation("actions", fields: [participantId], references: [id])
  group       Group @relation(fields: [groupId], references: [id])

  @@index([tenantId])
  @@index([participantId])
  @@index([tenantId, isDemoData])
  @@map("pastoral_actions")
}

/// PastoralNote — relational memory: conversation, prayer, milestone
model PastoralNote {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  authorId      String    @map("author_id") @db.Uuid
  noteType      String    @map("note_type")
  content       String
  occurredAt    DateTime  @map("occurred_at")
  metadata      Json      @default("{}") @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  participant User @relation("notes", fields: [participantId], references: [id])

  @@index([tenantId])
  @@index([participantId, noteType])
  @@map("pastoral_notes")
}

/// OutreachIntent — private pastoral note from Admin Tenant about a leader for a given week (Cenário 03)
model OutreachIntent {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  targetLeaderId  String    @map("target_leader_id") @db.Uuid
  weekOf          DateTime  @map("week_of") @db.Timestamptz
  note            String    @db.VarChar(280)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([tenantId, createdByUserId, targetLeaderId, weekOf])
  @@index([tenantId])
  @@index([targetLeaderId])
  @@map("outreach_intents")
}

// ---------------------------------------------------------------------------
// Radar — Async pastoral status engine (Story 6-2)
// ---------------------------------------------------------------------------

/// RadarStatus — traffic-light pastoral status for a participant
enum RadarStatus {
  verde
  amarelo
  vermelho
}

/// RadarTrend — trend direction since last calculation
enum RadarTrend {
  melhorando
  estavel
  declinio
}

/// ParticipantRadarStatus — materialized async-calculated radar status per participant per group
model ParticipantRadarStatus {
  id                 String      @id @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  groupId            String      @map("group_id") @db.Uuid
  participantId      String      @map("participant_id") @db.Uuid
  status             RadarStatus
  trend              RadarTrend  @default(estavel)
  presencePercentage Decimal     @map("presence_percentage") @db.Decimal(5, 4)
  lastActiveAt       DateTime?   @map("last_active_at") @db.Timestamptz
  calculatedAt       DateTime    @default(now()) @map("calculated_at") @db.Timestamptz
  /// Story 13.3: reason for risk flag (absences | inactivity | absences+inactivity)
  riskReason       String?   @map("risk_reason") @db.VarChar(500)
  /// Story 13.3: timestamp of last manual override by pastor — guard 24h window
  manualOverrideAt DateTime? @map("manual_override_at") @db.Timestamptz

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  group       Group  @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participant User   @relation("radarStatuses", fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, groupId, participantId])
  @@index([tenantId, groupId])
  @@index([participantId])
  @@map("participant_radar_status")
}

/// ParticipantStatusImproved — positive transition events for CelebrationBanner (Story 6-5).
/// Persists each positive radar status transition (vermelho→amarelo, amarelo→verde).
/// Auto-dismissed after 24 h via query filter on createdAt.
model ParticipantStatusImproved {
  id             String      @id @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  groupId        String      @map("group_id") @db.Uuid
  participantId  String      @map("participant_id") @db.Uuid
  previousStatus RadarStatus @map("previous_status")
  newStatus      RadarStatus @map("new_status")
  trend          RadarTrend  @default(estavel)
  seenAt         DateTime?   @map("seen_at") @db.Timestamptz
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  group       Group  @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participant User   @relation("statusImprovements", fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, groupId])
  @@index([participantId])
  @@index([tenantId, createdAt])
  @@map("participant_status_improved")
}

/// Public marketing funnel — no tenant_id, no RLS by design.
/// Captures inbound demo requests from /comecar before any tenant exists.
model DemoRequest {
  id         String   @id @db.Uuid
  fullName   String   @map("full_name") @db.VarChar(120)
  email      String   @db.VarChar(255)
  churchName String   @map("church_name") @db.VarChar(160)
  churchSize String   @map("church_size") @db.VarChar(16)
  role       String?  @db.VarChar(120)
  ipAddress  String   @map("ip_address") @db.VarChar(64)
  userAgent  String   @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@index([createdAt])
  @@map("demo_requests")
}

/// Public marketing funnel — no tenant_id, no RLS by design.
/// Captures inbound contact messages from /contato before any tenant exists.
model ContactMessage {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(120)
  email     String   @db.VarChar(255)
  message   String   @db.VarChar(2000)
  ipAddress String   @map("ip_address") @db.VarChar(64)
  userAgent String   @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@index([createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Content — Trilhas, Módulos e Aulas (Story 8-1)
// ---------------------------------------------------------------------------

/// TrailStatus — lifecycle state of a discipleship trail
enum TrailStatus {
  draft
  published
  archived
}

/// TrailAccessMode — sequential enforces module order; free allows any module
enum TrailAccessMode {
  sequential
  free
}

/// LessonAccessMode — sequential enforces lesson order within a module; free allows any lesson
enum LessonAccessMode {
  sequential
  free
}

/// LessonContentType — type of media/content for a lesson
enum LessonContentType {
  video
  rich_text
  pdf_doc
  external_link
}

/// Trail — top-level discipleship trail owned by a tenant
model Trail {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  name           String          @db.VarChar(255)
  description    String?         @db.VarChar(1000)
  status         TrailStatus     @default(draft)
  accessMode     TrailAccessMode @default(free) @map("access_mode")
  /// Publishing fields (Story 8-6)
  version        Int?
  publishedAt    DateTime?       @map("published_at") @db.Timestamptz
  publishedBy    String?         @map("published_by") @db.Uuid
  catalogVisible Boolean         @default(false) @map("catalog_visible")
  createdBy      String          @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  isDemoData     Boolean         @default(false) @map("is_demo_data")

  modules       Module[]
  trailVersions TrailVersion[]
  groupTrails   GroupTrail[]
  contentTemplates ContentTemplate[] @relation("TrailTemplates")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, catalogVisible])
  @@index([tenantId, isDemoData])
  @@map("trails")
}

/// TrailVersion — immutable snapshot of a trail at publish time (Story 8-6)
model TrailVersion {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  trailId      String   @map("trail_id") @db.Uuid
  version      Int
  snapshotData Json     @map("snapshot_data")
  publishedAt  DateTime @map("published_at") @db.Timestamptz
  publishedBy  String   @map("published_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  trail Trail @relation(fields: [trailId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([trailId, version])
  @@index([tenantId])
  @@map("trail_versions")
}

/// GroupTrail — N:N join between groups and trails (owned by Story 8-6; endpoints in Story 4-4)
model GroupTrail {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  trailId    String   @map("trail_id") @db.Uuid
  assignedBy String   @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trail Trail @relation(fields: [trailId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([groupId, trailId])
  @@index([tenantId])
  @@map("group_trails")
}

/// Module — ordered module within a trail
model Module {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  trailId          String           @map("trail_id") @db.Uuid
  name             String           @db.VarChar(255)
  order            Int
  lessonAccessMode LessonAccessMode @default(free) @map("lesson_access_mode")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz
  isDemoData       Boolean          @default(false) @map("is_demo_data")

  trail             Trail                @relation(fields: [trailId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lessons           Lesson[]
  prerequisites     ModulePrerequisite[] @relation("ModulePrerequisites")
  isPrerequisiteFor ModulePrerequisite[] @relation("PrerequisiteModule")

  @@index([tenantId])
  @@index([trailId])
  @@index([tenantId, isDemoData])
  @@map("modules")
}

/// ModulePrerequisite — join table enforcing that a module requires another module to be completed first
model ModulePrerequisite {
  tenantId             String @map("tenant_id") @db.Uuid
  moduleId             String @map("module_id") @db.Uuid
  prerequisiteModuleId String @map("prerequisite_module_id") @db.Uuid

  module             Module @relation("ModulePrerequisites", fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  prerequisiteModule Module @relation("PrerequisiteModule", fields: [prerequisiteModuleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([moduleId, prerequisiteModuleId])
  @@unique([tenantId, moduleId, prerequisiteModuleId])
  @@index([tenantId])
  @@index([moduleId])
  @@map("module_prerequisites")
}

/// Lesson — ordered lesson within a module
model Lesson {
  id                       String            @id @db.Uuid
  tenantId                 String            @map("tenant_id") @db.Uuid
  moduleId                 String            @map("module_id") @db.Uuid
  name                     String            @db.VarChar(255)
  contentType              LessonContentType @map("content_type")
  contentUrl               String?           @map("content_url") @db.VarChar(2048)
  contentBody              String?           @map("content_body") @db.Text
  tags                     String[]          @default([])
  originalName             String?           @map("original_name") @db.VarChar(512)
  mimeType                 String?           @map("mime_type") @db.VarChar(255)
  sizeBytes                BigInt?           @map("size_bytes")
  uploadedBy               String?           @map("uploaded_by") @db.Uuid
  uploadedAt               DateTime?         @map("uploaded_at") @db.Timestamptz
  order                    Int
  estimatedDurationMinutes Int?              @map("estimated_duration_minutes")
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                DateTime?         @map("deleted_at") @db.Timestamptz
  isDemoData               Boolean           @default(false) @map("is_demo_data")

  searchVector Unsupported("tsvector")? @map("search_vector")

  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lessonProgresses LessonProgress[]

  @@index([tenantId])
  @@index([moduleId])
  @@index([searchVector], type: Gin)
  @@index([tenantId, isDemoData])
  @@map("lessons")
}

// ---------------------------------------------------------------------------
// Progress Tracking — Story 8-3
// ---------------------------------------------------------------------------

/// CompletedBy — who triggered lesson completion
enum CompletedBy {
  participant
  leader
}

/// LessonStatus — progress state of a lesson for a user
enum LessonStatus {
  not_started
  in_progress
  completed
}

enum TemplateScope {
  platform
  tenant
}

/// LessonProgress — async-persisted progress for a user on a specific lesson
model LessonProgress {
  id              String       @id @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  lessonId        String       @map("lesson_id") @db.Uuid
  status          LessonStatus @default(not_started)
  progressPercent Int          @default(0) @map("progress_percent")
  startedAt       DateTime?    @map("started_at") @db.Timestamptz
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz
  lastAccessedAt  DateTime     @default(now()) @map("last_accessed_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  completedBy CompletedBy? @map("completed_by")
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, userId, lessonId])
  @@index([tenantId, userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

/// ModuleProgress — aggregated progress for a user on a module (persisted for "Meu Progresso")
model ModuleProgress {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  moduleId         String    @map("module_id") @db.Uuid
  progressPercent  Int       @default(0) @map("progress_percent")
  completedLessons Int       @default(0) @map("completed_lessons")
  totalLessons     Int       @default(0) @map("total_lessons")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  isDemoData       Boolean   @default(false) @map("is_demo_data")

  @@unique([tenantId, userId, moduleId])
  @@index([tenantId, userId])
  @@index([tenantId, isDemoData])
  @@map("module_progress")
}

/// TrailProgress — aggregated progress for a user on a trail (persisted for "Meu Progresso")
model TrailProgress {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  trailId          String    @map("trail_id") @db.Uuid
  progressPercent  Int       @default(0) @map("progress_percent")
  completedModules Int       @default(0) @map("completed_modules")
  totalModules     Int       @default(0) @map("total_modules")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  isDemoData       Boolean   @default(false) @map("is_demo_data")

  @@unique([tenantId, userId, trailId])
  @@index([tenantId, userId])
  @@index([tenantId, isDemoData])
  @@map("trail_progress")
}

