generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Health check table — validates DB connectivity and migration status
model Health {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  status    String   @default("ok")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("_health")
}

/// Meeting event — stores real-time pipeline events for audit and replay
model MeetingEvent {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  eventType String   @map("event_type")
  userId    String?  @map("user_id") @db.Uuid
  payload   Json     @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, meetingId])
  @@map("meeting_events")
}

/// Meeting — a scheduled gathering for a discipleship group; lifecycle scheduled → live → ended → cancelled
model Meeting {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  groupId         String    @map("group_id") @db.Uuid
  title           String?   @db.VarChar(200)
  scheduledFor    DateTime  @map("scheduled_for") @db.Timestamptz
  durationMinutes Int?      @map("duration_minutes")
  status          String    @default("scheduled") @db.VarChar(16)
  topic           String?   @db.VarChar(500)
  livekitRoomId   String?   @map("livekit_room_id") @db.VarChar(200)
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  participants MeetingParticipantRecord[]
  reflections  Reflection[]

  @@index([tenantId, groupId, scheduledFor])
  @@index([tenantId, status, scheduledFor])
  @@map("meetings")
}

/// MeetingParticipantRecord — per-meeting confirmation + presence (joinedAt/leftAt auto-filled by LiveKit webhooks)
model MeetingParticipantRecord {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  meetingId     String    @map("meeting_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  name          String    @db.VarChar(200)
  response      String    @default("pending") @db.VarChar(8)
  joinedAt      DateTime? @map("joined_at") @db.Timestamptz
  leftAt        DateTime? @map("left_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, participantId])
  @@index([tenantId, meetingId])
  @@map("meeting_participants")
}

/// MeetingAttendance — final aggregated presence record after meeting end (Story 5.3)
model MeetingAttendance {
  id                    String   @id @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  meetingId             String   @map("meeting_id") @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  joinTime              DateTime @map("join_time") @db.Timestamptz
  leaveTime             DateTime @map("leave_time") @db.Timestamptz
  totalDurationSeconds  Int      @map("total_duration_seconds")
  presenceType          String   @map("presence_type") @db.VarChar(16)
  reconnections         Int      @default(0)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([meetingId, userId])
  @@index([tenantId, meetingId])
  @@index([tenantId, userId])
  @@map("meeting_attendance")
}

/// MeetingTelemetry — per-user engagement signals captured during a meeting (Story 5.4)
model MeetingTelemetry {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  meetingId            String   @map("meeting_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  cameraOnSeconds      Int      @map("camera_on_seconds") @default(0)
  roomDurationSeconds  Int      @map("room_duration_seconds") @default(0)
  focusScore           Decimal? @map("focus_score") @db.Decimal(3, 2)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([meetingId, userId])
  @@index([tenantId, meetingId])
  @@map("meeting_telemetry")
}

/// MeetingReport — post-meeting aggregated report (attendees + metrics) (Story 5.6)
model MeetingReport {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  meetingId   String   @map("meeting_id") @db.Uuid
  summary     Json     @default("{}")
  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz

  @@unique([meetingId])
  @@index([tenantId, meetingId])
  @@map("meeting_reports")
}

/// MeetingSnapshot — periodic state checkpoint for crash recovery (Story 5.3)
model MeetingSnapshot {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  meetingId    String   @map("meeting_id") @db.Uuid
  snapshotData Json     @map("snapshot_data") @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, meetingId, createdAt])
  @@map("meeting_snapshots")
}

/// Reflection — post-meeting narrative capture by the leader (1–280 chars, Zod enforced)
model Reflection {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  meetingId  String   @map("meeting_id") @db.Uuid
  leaderId   String   @map("leader_id") @db.Uuid
  text       String   @db.VarChar(280)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([tenantId, meetingId])
  @@map("reflections")
}

/// Platform user — created at registration, tenant assigned later
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  status    String   @default("pending_verification")
  tenantId  String?  @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userTenants      UserTenant[]
  consents         Consent[]
  groupMemberships GroupMember[]
  pastoralAlerts   PastoralAlert[]  @relation("alerts")
  pastoralActions  PastoralAction[] @relation("actions")
  pastoralNotes    PastoralNote[]   @relation("notes")

  @@index([tenantId])
  @@map("users")
}

/// Join table — associates users with tenants and their role within each
model UserTenant {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  role      String   @default("participante")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

/// Consent record — tracks user acceptance of legal documents (LGPD)
model Consent {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  documentType String   @map("document_type")
  version      String
  ipAddress    String   @map("ip_address")
  userAgent    String   @map("user_agent")
  acceptedAt   DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("consents")
}

/// Tenant — materializes the implicit tenant, self-referencing tenant_id for universal RLS
model Tenant {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  name              String
  slug              String?  @unique @db.VarChar(60)
  plan              String   @default("free") @db.VarChar(20)
  status            String   @default("active") @db.VarChar(32)
  adminEmail        String?  @map("admin_email") @db.VarChar(320)
  provisioningState Json?    @map("provisioning_state")
  isDemo                  Boolean  @default(false) @map("is_demo")
  focusIndicatorEnabled   Boolean  @default(false) @map("focus_indicator_enabled")
  metadata                Json     @default("{}") @map("metadata") @db.JsonB
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  groups  Group[]
  invites Invite[]

  @@index([tenantId])
  @@index([status])
  @@index([plan])
  @@map("tenants")
}

/// Invite — pre-tenant onboarding token for admin/leader signup (5-leg flow)
model Invite {
  id              String    @id @db.Uuid
  token           String    @unique @db.Text
  tenantId        String?   @map("tenant_id") @db.Uuid
  leaderName      String    @map("leader_name") @db.VarChar(200)
  leaderEmail     String    @map("leader_email") @db.VarChar(320)
  churchName      String?   @map("church_name") @db.VarChar(200)
  kind            String    @default("pre_tenant_signup") @db.VarChar(32)
  inviteeRole     String?   @map("invitee_role") @db.VarChar(32)
  groupId         String?   @map("group_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([kind])
  @@map("invites")
}

/// Group — a discipleship small group within a tenant
model Group {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  dayOfWeek  String   @map("day_of_week") @db.VarChar(8)
  time       String   @db.VarChar(5)
  recurrence String   @default("weekly") @db.VarChar(16)
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  members GroupMember[]
  alerts  PastoralAlert[]
  actions PastoralAction[]

  @@index([tenantId])
  @@map("groups")
}

/// GroupMember — join table associating users with groups and their role within
model GroupMember {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("membro")
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([tenantId])
  @@map("group_members")
}

/// PastoralAlert — materialized signal per participant, written by signal engine, read by radar
model PastoralAlert {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  participantId   String   @map("participant_id") @db.Uuid
  groupId         String   @map("group_id") @db.Uuid
  signalType      String   @map("signal_type")
  signalVariant   String?  @map("signal_variant")
  contextPhrase   String?  @map("context_phrase")
  observedFact    String?  @map("observed_fact")
  systemLimitation String? @map("system_limitation")
  presenceDots    Json     @default("[]") @map("presence_dots")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  participant User  @relation("alerts", fields: [participantId], references: [id])
  group       Group @relation(fields: [groupId], references: [id])

  @@index([tenantId, active])
  @@index([participantId])
  @@map("pastoral_alerts")
}

/// PastoralAction — care action recorded by the leader
model PastoralAction {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  performedBy   String   @map("performed_by") @db.Uuid
  actionType    String   @map("action_type")
  signalType    String   @map("signal_type")
  note          String?
  recordedAt    DateTime @default(now()) @map("recorded_at")

  participant User  @relation("actions", fields: [participantId], references: [id])
  group       Group @relation(fields: [groupId], references: [id])

  @@index([tenantId])
  @@index([participantId])
  @@map("pastoral_actions")
}

/// PastoralNote — relational memory: conversation, prayer, milestone
model PastoralNote {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  noteType      String   @map("note_type")
  content       String
  occurredAt    DateTime @map("occurred_at")
  metadata      Json     @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")

  participant User @relation("notes", fields: [participantId], references: [id])

  @@index([tenantId])
  @@index([participantId, noteType])
  @@map("pastoral_notes")
}

/// OutreachIntent — private pastoral note from Admin Tenant about a leader for a given week (Cenário 03)
model OutreachIntent {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  targetLeaderId  String   @map("target_leader_id") @db.Uuid
  weekOf          DateTime @map("week_of") @db.Timestamptz
  note            String   @db.VarChar(280)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, createdByUserId, targetLeaderId, weekOf])
  @@index([tenantId])
  @@index([targetLeaderId])
  @@map("outreach_intents")
}

/// Public marketing funnel — no tenant_id, no RLS by design.
/// Captures inbound demo requests from /comecar before any tenant exists.
model DemoRequest {
  id         String   @id @db.Uuid
  fullName   String   @map("full_name") @db.VarChar(120)
  email      String   @db.VarChar(255)
  churchName String   @map("church_name") @db.VarChar(160)
  churchSize String   @map("church_size") @db.VarChar(16)
  role       String?  @db.VarChar(120)
  ipAddress  String   @map("ip_address") @db.VarChar(64)
  userAgent  String   @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@index([createdAt])
  @@map("demo_requests")
}

/// Public marketing funnel — no tenant_id, no RLS by design.
/// Captures inbound contact messages from /contato before any tenant exists.
model ContactMessage {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(120)
  email     String   @db.VarChar(255)
  message   String   @db.VarChar(2000)
  ipAddress String   @map("ip_address") @db.VarChar(64)
  userAgent String   @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@index([createdAt])
  @@map("contact_messages")
}
