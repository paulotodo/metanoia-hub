generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Health check table — validates DB connectivity and migration status
model Health {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  status    String   @default("ok")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("_health")
}

/// Meeting event — stores real-time pipeline events for audit and replay
model MeetingEvent {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  eventType String   @map("event_type")
  userId    String?  @map("user_id") @db.Uuid
  payload   Json     @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, meetingId])
  @@map("meeting_events")
}

/// Platform user — created at registration, tenant assigned later
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  status    String   @default("pending_verification")
  tenantId  String?  @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userTenants      UserTenant[]
  consents         Consent[]
  groupMemberships GroupMember[]
  pastoralAlerts   PastoralAlert[]  @relation("alerts")
  pastoralActions  PastoralAction[] @relation("actions")
  pastoralNotes    PastoralNote[]   @relation("notes")

  @@index([tenantId])
  @@map("users")
}

/// Join table — associates users with tenants and their role within each
model UserTenant {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  role      String   @default("participante")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

/// Consent record — tracks user acceptance of legal documents (LGPD)
model Consent {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  documentType String   @map("document_type")
  version      String
  ipAddress    String   @map("ip_address")
  userAgent    String   @map("user_agent")
  acceptedAt   DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("consents")
}

/// Tenant — materializes the implicit tenant, self-referencing tenant_id for universal RLS
model Tenant {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  groups  Group[]
  invites Invite[]

  @@index([tenantId])
  @@map("tenants")
}

/// Invite — pre-tenant onboarding token for admin/leader signup (5-leg flow)
model Invite {
  id              String    @id @db.Uuid
  token           String    @unique @db.Text
  tenantId        String?   @map("tenant_id") @db.Uuid
  leaderName      String    @map("leader_name") @db.VarChar(200)
  leaderEmail     String    @map("leader_email") @db.VarChar(320)
  churchName      String?   @map("church_name") @db.VarChar(200)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("invites")
}

/// Group — a discipleship small group within a tenant
model Group {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  dayOfWeek  String   @map("day_of_week") @db.VarChar(8)
  time       String   @db.VarChar(5)
  recurrence String   @default("weekly") @db.VarChar(16)
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  members GroupMember[]
  alerts  PastoralAlert[]
  actions PastoralAction[]

  @@index([tenantId])
  @@map("groups")
}

/// GroupMember — join table associating users with groups and their role within
model GroupMember {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("membro")
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([tenantId])
  @@map("group_members")
}

/// PastoralAlert — materialized signal per participant, written by signal engine, read by radar
model PastoralAlert {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  participantId   String   @map("participant_id") @db.Uuid
  groupId         String   @map("group_id") @db.Uuid
  signalType      String   @map("signal_type")
  signalVariant   String?  @map("signal_variant")
  contextPhrase   String?  @map("context_phrase")
  observedFact    String?  @map("observed_fact")
  systemLimitation String? @map("system_limitation")
  presenceDots    Json     @default("[]") @map("presence_dots")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  participant User  @relation("alerts", fields: [participantId], references: [id])
  group       Group @relation(fields: [groupId], references: [id])

  @@index([tenantId, active])
  @@index([participantId])
  @@map("pastoral_alerts")
}

/// PastoralAction — care action recorded by the leader
model PastoralAction {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  performedBy   String   @map("performed_by") @db.Uuid
  actionType    String   @map("action_type")
  signalType    String   @map("signal_type")
  note          String?
  recordedAt    DateTime @default(now()) @map("recorded_at")

  participant User  @relation("actions", fields: [participantId], references: [id])
  group       Group @relation(fields: [groupId], references: [id])

  @@index([tenantId])
  @@index([participantId])
  @@map("pastoral_actions")
}

/// PastoralNote — relational memory: conversation, prayer, milestone
model PastoralNote {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  noteType      String   @map("note_type")
  content       String
  occurredAt    DateTime @map("occurred_at")
  metadata      Json     @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")

  participant User @relation("notes", fields: [participantId], references: [id])

  @@index([tenantId])
  @@index([participantId, noteType])
  @@map("pastoral_notes")
}
