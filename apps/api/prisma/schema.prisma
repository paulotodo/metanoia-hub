generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Health check table — validates DB connectivity and migration status
model Health {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  status    String   @default("ok")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("_health")
}

/// Meeting event — stores real-time pipeline events for audit and replay
model MeetingEvent {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  eventType String   @map("event_type")
  userId    String?  @map("user_id") @db.Uuid
  payload   Json     @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, meetingId])
  @@map("meeting_events")
}

/// Platform user — created at registration, tenant assigned later
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  status    String   @default("pending_verification")
  tenantId  String?  @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userTenants UserTenant[]
  consents    Consent[]

  @@index([tenantId])
  @@map("users")
}

/// Join table — associates users with tenants and their role within each
model UserTenant {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  role      String   @default("participante")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

/// Consent record — tracks user acceptance of legal documents (LGPD)
model Consent {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  documentType String   @map("document_type")
  version      String
  ipAddress    String   @map("ip_address")
  userAgent    String   @map("user_agent")
  acceptedAt   DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("consents")
}
