// ---------------------------------------------------------------------------
// Audit Events — Story 9-3 (LGPD Immutable Audit Log)
// dec-015 (SEC-005): id via generateId() (UUIDv7), no DB default
// dec-018 (SEC-006): ipAddress TEXT (not INET)
// dec-016 (SEC-011): userId nullable (public route captures)
// FR-INFRA-02: no update() / delete() exposed anywhere in the service
// ---------------------------------------------------------------------------

/// AuditEvent — immutable record of every state-changing action in the system.
/// RLS: tenant-scoped INSERT + SELECT only. No UPDATE/DELETE policies (enforces immutability).
/// Super Admin reads cross-tenant via prisma.client (bypasses RLS per dec-015).
model AuditEvent {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  /// userId: nullable — public route captures may have no authenticated user (dec-016)
  userId            String?  @map("user_id") @db.Uuid
  action            String   @map("action")
  resource          String   @map("resource")
  resourceId        String?  @map("resource_id")
  /// ipAddress: TEXT (not INET) — supports IPv6 bracket notation and proxies (dec-018)
  ipAddress         String   @map("ip_address")
  userAgent         String   @map("user_agent")
  /// previousState: null when AuditContext not populated by service (dec-016)
  previousState     Json?    @map("previous_state")
  /// newState: may be truncated marker if payload > 65536 bytes (dec-019)
  newState          Json?    @map("new_state")
  timestamp         DateTime @default(now()) @map("timestamp") @db.Timestamptz
  severity          String   @map("severity")
  /// anonymizedUserRef: set by hard-delete worker when userId is nullified (Story 9-2 / LGPD Art. 18 VI).
  /// Format: 'anonymous-<sha256[:8]>' — cross-references Users.anonymized_user_ref for traceability without PII.
  anonymizedUserRef String?  @map("anonymized_user_ref")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp(sort: Desc)])
  @@index([tenantId, userId])
  @@index([tenantId, action])
  @@map("audit_events")
}

/// TenantContentConfig — per-tenant overrides for completion thresholds
/// Convention over configuration: when absent, defaults apply (video 90%, doc 80%)
model TenantContentConfig {
  id                         String   @id @db.Uuid
  tenantId                   String   @unique @map("tenant_id") @db.Uuid
  videoThresholdPercent      Int      @default(90) @map("video_threshold_percent")
  docScrollThresholdPercent  Int      @default(80) @map("doc_scroll_threshold_percent")
  allowManualVideoCompletion Boolean  @default(false) @map("allow_manual_video_completion")
  allowManualDocCompletion   Boolean  @default(false) @map("allow_manual_doc_completion")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tenant_content_config")
}

/// PrivacyExportJob — tracks async data export requests (Story 9-1 / LGPD Art. 20)
/// Worker mode: privileged (no RLS on queries), RLS enabled for HTTP polling.
/// allTenantIds: captured at request time to avoid cross-tenant data leakage in worker.
model PrivacyExportJob {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  format        String    @default("json")
  status        String    @default("accepted")
  allTenantIds  String[]  @map("all_tenant_ids") @db.Uuid
  objectKey     String?   @map("object_key")
  signedUrl     String?   @map("signed_url")
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  failureReason String?   @map("failure_reason")
  requestedAt   DateTime  @map("requested_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId], map: "idx_privacy_export_jobs_user_id")
  @@index([tenantId, userId], map: "idx_privacy_export_jobs_tenant_user")
  @@map("privacy_export_jobs")
}

/// DeletionRequest — tracks async deletion requests (Story 9-2 / LGPD Art. 18 VI)
/// RLS: tenant-scoped INSERT + SELECT + UPDATE. Worker bypasses RLS (privileged).
/// allTenantIds: captured at request time for cross-tenant sweep.
model DeletionRequest {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  status           String    @default("pending")
  allTenantIds     String[]  @map("all_tenant_ids") @db.Uuid
  cancellableUntil DateTime  @map("cancellable_until") @db.Timestamptz
  deletionDeadline DateTime  @map("deletion_deadline") @db.Timestamptz
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  failureReason    String?   @map("failure_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId], map: "idx_deletion_requests_user_id")
  @@index([tenantId, userId], map: "idx_deletion_requests_tenant_user")
  @@map("deletion_requests")
}

/// SubscriptionPlan — global table (no tenant_id / no RLS by tenant).
/// SUPER_ADMIN manages tiers; PlanLimitsService reads for getLimits().
/// Story 11-1 / FR-INFRA-02, FR-INFRA-06.
model SubscriptionPlan {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(100)
  tier      String   @unique @db.VarChar(20)
  limits    Json     @db.JsonB
  features  Json     @default("{}") @db.JsonB
  metadata  Json     @default("{}") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("subscription_plans")
}

model MvRefreshLog {
  id          String    @id @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  mvName      String    @map("mv_name") @db.VarChar(64)
  refreshedAt DateTime  @default(now()) @map("refreshed_at") @db.Timestamptz
  durationMs  Int       @map("duration_ms")
  status      String    @db.VarChar(16)

  @@index([mvName, refreshedAt])
  @@map("mv_refresh_log")
}

/// EvasionJobLog — observability table for the detect-evasion-risk daily job (Story 13.3)
/// tenant_id NULL = global job run entry; non-NULL = per-tenant error entry
model EvasionJobLog {
  id                  String    @id @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid
  jobRunId            String    @map("job_run_id") @db.Uuid
  status              String    @db.VarChar(16)
  durationMs          Int?      @map("duration_ms")
  tenantsProcessed    Int       @default(0) @map("tenants_processed")
  participantsFlagged Int       @default(0) @map("participants_flagged")
  errorMessage        String?   @map("error_message") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobRunId, createdAt])
  @@index([tenantId, createdAt])
  @@map("evasion_job_log")
}

/// TenantStorageUsage — contagem de bytes usados por tenant (hook de upload SEC-03).
/// Alimentada por StorageService.upload(); lida pela mv_platform_metrics.
/// RLS: política permissiva para super-admin cross-tenant (nullif).
model TenantStorageUsage {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  bytesUsed BigInt   @default(0) @map("bytes_used")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tenant_storage_usage")
}

/// ContentTemplate — snapshot imutável da ESTRUTURA de uma trilha (Story 13-5 / FR42).
/// structure JSONB contém apenas metadados estruturais — NUNCA conteúdo real (URLs, bodies).
/// tenant_id NULL = template de plataforma (visível a todos); tenant_id NOT NULL = template de tenant.
model ContentTemplate {
  id            String        @id @db.Uuid
  tenantId      String?       @map("tenant_id") @db.Uuid
  scope         TemplateScope
  sourceTrailId String?       @map("source_trail_id") @db.Uuid
  name          String        @db.VarChar(500)
  description   String?       @db.VarChar(1000)
  version       Int           @default(1)
  structure     Json
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(6)

  sourceTrail Trail? @relation("TrailTemplates", fields: [sourceTrailId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, scope])
  @@index([tenantId, deletedAt])
  @@index([sourceTrailId])
  @@map("content_templates")
}

enum NotificationType {
  pastoral_alert
  group_message
  content_update
  meeting_reminder
  system

  @@map("notification_type")
}

enum NotificationChannel {
  in_app
  email

  @@map("notification_channel")
}

enum NotificationStatus {
  pending
  sent
  failed
  read

  @@map("notification_status")
}

/// Notification — infra-notificacoes Story 14-1 (FR77)
model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus  @default(pending)
  title     String              @db.VarChar(200)
  body      String              @db.Text
  metadata  Json                @default("{}") @db.JsonB
  readAt    DateTime?           @map("read_at") @db.Timestamptz
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, status, createdAt(sort: Desc)], name: "notifications_user_status_created_idx")
  @@index([tenantId], name: "notifications_tenant_idx")
  @@map("notifications")
}
