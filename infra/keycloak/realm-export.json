{
  "realm": "metanoia",
  "enabled": true,
  "displayName": "Metanoia Hub",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "browserFlow": "metanoia browser",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpSupportedApplications": ["totpAppGoogleName", "totpAppFreeOTPName", "totpAppMicrosoftAuthenticatorName"],
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Platform-wide administrator with full access"
      },
      {
        "name": "admin_tenant",
        "description": "Tenant administrator managing users, groups and settings"
      },
      {
        "name": "editor_conteudo",
        "description": "Content editor with trail and module management"
      },
      {
        "name": "lider",
        "description": "Group leader with pastoral dashboard access"
      },
      {
        "name": "participante",
        "description": "Regular participant in groups and trails"
      },
      {
        "name": "auditor",
        "description": "Read-only auditor with compliance report access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "metanoia-web",
      "name": "Metanoia Hub Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "https://app.metanoia-hub.todo-tips.com",
      "baseUrl": "/",
      "redirectUris": [
        "https://app.metanoia-hub.todo-tips.com/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "https://app.metanoia-hub.todo-tips.com",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://app.metanoia-hub.todo-tips.com/*##http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "user_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "user_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-metanoia-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "metanoia-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "metanoia-api",
      "name": "Metanoia Hub API",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "${KEYCLOAK_API_CLIENT_SECRET:dev-secret-only-not-for-production}",
      "attributes": {
        "use.refresh.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "user_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "user_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_OAUTH_CLIENT_ID:REPLACE_WITH_GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET:REPLACE_WITH_GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT",
        "useJwksUrl": "true"
      }
    }
  ],
  "scopeMappings": [],
  "clientScopeMappings": {},
  "users": [
    {
      "username": "admin@metanoia.dev",
      "email": "admin@metanoia.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["super_admin"],
      "requiredActions": ["CONFIGURE_TOTP"],
      "attributes": {
        "tenant_id": ["dev-tenant-001"]
      }
    },
    {
      "username": "admin-tenant@metanoia.dev",
      "email": "admin-tenant@metanoia.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin Tenant",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "admintenant123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin_tenant"],
      "requiredActions": ["CONFIGURE_TOTP"],
      "attributes": {
        "tenant_id": ["dev-tenant-001"]
      }
    },
    {
      "username": "lider@metanoia.dev",
      "email": "lider@metanoia.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Líder",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "lider123",
          "temporary": false
        }
      ],
      "realmRoles": ["lider"],
      "attributes": {
        "tenant_id": ["dev-tenant-001"]
      }
    },
    {
      "username": "participante@metanoia.dev",
      "email": "participante@metanoia.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Participante",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "participante123",
          "temporary": false
        }
      ],
      "realmRoles": ["participante"],
      "attributes": {
        "tenant_id": ["dev-tenant-001"]
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "metanoia browser",
      "description": "Browser-based authentication that requires TOTP for super_admin and admin_tenant roles (Story 2-3).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "metanoia forms",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "metanoia forms",
      "description": "Username + password followed by conditional MFA based on realm role.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "metanoia conditional otp super_admin",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "metanoia conditional otp admin_tenant",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "metanoia conditional otp super_admin",
      "description": "Require OTP if user has the super_admin realm role.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "metanoia-mfa-cfg-super-admin",
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "metanoia conditional otp admin_tenant",
      "description": "Require OTP if user has the admin_tenant realm role.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "metanoia-mfa-cfg-admin-tenant",
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "metanoia-mfa-cfg-super-admin",
      "config": { "condUserRole": "super_admin" }
    },
    {
      "alias": "metanoia-mfa-cfg-admin-tenant",
      "config": { "condUserRole": "admin_tenant" }
    }
  ]
}
