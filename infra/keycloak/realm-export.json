      }
    },
    {
      "username": "participante@metanoia.dev",
      "email": "participante@metanoia.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Participante",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "participante123",
